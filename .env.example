# Copy this file to .env. The CLI loads it locally without overriding existing environment variables.
TAKEALOT_API_KEY=
# Multi-store example (keep every real key only in .env):
# TAKEALOT_STORE_02_API_KEY=
# TAKEALOT_STORES=current|官方店铺显示名A|TAKEALOT_API_KEY;store-02|官方店铺显示名B|TAKEALOT_STORE_02_API_KEY
TAKEALOT_BASE_URL=https://marketplace-api.takealot.com/v1
TAKEALOT_DATABASE_URL=mysql+pymysql://takealot_app:CHANGE_ME@127.0.0.1:3306/takealot_ops?charset=utf8mb4
TAKEALOT_BACKUP_DATABASE_URL=mysql+pymysql://takealot_backup:CHANGE_ME@127.0.0.1:3306/takealot_ops?charset=utf8mb4
TAKEALOT_BACKUP_ROOT=D:\南非店铺数据抓取\backups
TAKEALOT_BINLOG_RETENTION_DAYS=35
TAKEALOT_REQUEST_TIMEOUT_SECONDS=30.0
TAKEALOT_DASHBOARD_HOST=0.0.0.0
TAKEALOT_DASHBOARD_PORT=8501
# Undocumented Seller Portal BFF integration: keep disabled until the operator has
# reviewed the safety notes and is ready for a separately authorized live test.
# Passwords are provisioned per store from the server console into Windows Credential
# Manager; OTP and bearer tokens stay in process memory. None belong in this file.
TAKEALOT_PORTAL_BFF_ENABLED=false
# Required store-code allowlist. An empty value keeps every store disabled.
TAKEALOT_PORTAL_ENABLED_STORES=
TAKEALOT_PORTAL_REQUEST_TIMEOUT_SECONDS=30
TAKEALOT_PORTAL_TASK_TIMEOUT_SECONDS=45
TAKEALOT_PORTAL_MAX_TOTAL_QUANTITY=500
# Enable only after confirming the current mark-shipped /v1 path with an authorized
# manual network capture. The current public bundle contains a suspicious `vi/` typo.
TAKEALOT_PORTAL_SHIPPED_WRITE_ENABLED=false
W8_API_TOKEN=
W8_BASE_URL=https://crgyl.w8soft.net/prod-api/w8
W8_REQUEST_TIMEOUT_SECONDS=30.0

# Search positioning uses Doubao as the primary multimodal provider and Qwen as
# the cross-vendor fallback. Codex CLI integration files are retained, but the
# production service has no Codex execution entry point.
ARK_API_KEY=
TAKEALOT_SEARCH_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TAKEALOT_SEARCH_DOUBAO_MODEL=doubao-seed-2-0-lite-260215
TAKEALOT_SEARCH_DOUBAO_INPUT_PRICE_CNY_PER_MILLION=0.6
TAKEALOT_SEARCH_DOUBAO_OUTPUT_PRICE_CNY_PER_MILLION=3.6
DASHSCOPE_API_KEY=
TAKEALOT_SEARCH_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TAKEALOT_SEARCH_QWEN_MODEL=qwen3.7-plus
TAKEALOT_SEARCH_QWEN_INPUT_PRICE_CNY_PER_MILLION=2.0
TAKEALOT_SEARCH_QWEN_OUTPUT_PRICE_CNY_PER_MILLION=8.0
TAKEALOT_SEARCH_MAX_PAGES=5
TAKEALOT_SEARCH_MAX_KEYWORDS=14
TAKEALOT_SEARCH_CONFIDENCE_THRESHOLD=0.68
TAKEALOT_SEARCH_RELEVANCE_THRESHOLD=0.60
TAKEALOT_SEARCH_MODEL_TIMEOUT_SECONDS=60
# 搜索定位内所有公开补全、第一页和游标翻页请求的全局最小间隔（秒）
TAKEALOT_SEARCH_PAGE_DELAY_SECONDS=3.0
# 在最小间隔上追加的随机抖动上限（秒）；0 表示关闭
TAKEALOT_SEARCH_PAGE_DELAY_JITTER_SECONDS=2.0
TAKEALOT_SEARCH_OFFER_MAX_AGE_HOURS=36
TAKEALOT_SEARCH_IMAGE_MAX_DIMENSION=640
